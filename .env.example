# ==============================================================================
# Vynora Environment Configuration Template
# Architecture: Firebase Cloud Firestore + Cloudinary Unsigned Uploads
# ==============================================================================

# --- SERVER CONFIGURATION ---
PORT=5000
OPENROUTER_API_KEY=your_openrouter_api_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@vynora.ai

# --- CLIENT FIREBASE AUTH & FIRESTORE CONFIGURATION (Vite) ---
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# --- CLIENT CLOUDINARY UNSIGNED UPLOAD CONFIGURATION (Vite) ---
# NOTE: Cloudinary API Secret is NEVER included in client code or client environment variables.
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# --- OPTIONAL CLIENT API BASE URL (Defaults to http://localhost:5000) ---
VITE_API_URL=http://localhost:5000
